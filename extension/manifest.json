{
  "manifest_version": 3,
  "name": "Atlas — Enviar vacante",
  "version": "1.0.0",
  "description": "Captura la vacante de la página actual y la manda a Atlas para adaptar tu CV.",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Enviar esta vacante a Atlas",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
