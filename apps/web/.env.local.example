# --- Supabase (auth + data) --------------------------------------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- DeepSeek (adaptation engine) ------------------------------------------
# https://platform.deepseek.com/api_keys  — leave blank to use the offline heuristic
DEEPSEEK_API_KEY=

# --- App -------------------------------------------------------------------
# Used by the OAuth redirect in production (http://localhost:3000 in dev is automatic)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


